set term png
set size 1,1
set terminal png size 840,840
set xtics rotate by -45
set xlabel "X (meters)"
set ylabel "Y (meters)"
set output "data/2/graph.png"
set title "Simulation trace, duration = 3.1536e+07 seconds, delta-t = 86400 seconds"
plot "data/2/13.dat" index 0 smooth path title "Earth" with lines,\
"data/2/14.dat" index 0 smooth path title "Mars" with lines,\
"data/2/15.dat" index 0 smooth path title "Jupiter" with lines,\
"data/2/10.dat" index 0 smooth path title "Sun" with lines,\
"data/2/11.dat" index 0 smooth path title "Mercury" with lines,\
"data/2/12.dat" index 0 smooth path title "Venus" with lines